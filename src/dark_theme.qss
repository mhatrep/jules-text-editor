/* Dark Theme */
QWidget {
    background-color: #2b2b2b;
    color: #ffffff;
}

QTreeView {
    background-color: #2b2b2b;
    color: #ffffff;
    alternate-background-color: #3c3f41;
}

QHeaderView::section {
    background-color: #3c3f41;
    color: #ffffff;
    padding: 4px;
    border: 1px solid #555555;
}

QTextEdit, QLineEdit, QComboBox, QSpinBox, QDateEdit {
    background-color: #3c3f41;
    color: #ffffff;
    border: 1px solid #555555;
    selection-background-color: #4b6eaf;
}

QPushButton {
    background-color: #3c3f41;
    color: #ffffff;
    border: 1px solid #555555;
    padding: 4px;
}

QPushButton:hover {
    background-color: #4c4f51;
}

QPushButton:pressed {
    background-color: #5c5f61;
}

QToolBar {
    background-color: #3c3f41;
    border: none;
}
